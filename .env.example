# ──────────────────────────────────────────────
# Ticket Booking System — Environment Variables
# ──────────────────────────────────────────────

# ─── Database ───
DATABASE_URL="postgresql://tbs_user:tbs_password@localhost:5432/ticket_booking?schema=public"

# ─── Redis ───
REDIS_URL="redis://localhost:6379"

# ─── Auth ───
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"
JWT_EXPIRATION="7d"
BCRYPT_SALT_ROUNDS=12

# ─── Server ───
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ─── Frontend ───
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# ─── Seat Hold ───
SEAT_HOLD_TTL_MINUTES=10

# ─── Waitlist ───
WAITLIST_OFFER_TTL_MINUTES=5

# ─── Email (Resend) ───
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="tickets@yourdomain.com"

# ─── Background Jobs ───
HOLD_EXPIRATION_INTERVAL_MS=10000
WAITLIST_OFFER_EXPIRATION_INTERVAL_MS=15000
