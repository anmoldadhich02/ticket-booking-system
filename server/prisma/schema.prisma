// ──────────────────────────────────────────────
// Ticket Booking System — Prisma Schema
// ──────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ──────────────────────────────────────

enum UserRole {
  CUSTOMER
  ORGANISER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(100)
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  organisedEvents Event[]          @relation("EventOrganiser")
  bookings        Booking[]
  seatHolds       SeatHold[]
  waitlistEntries WaitlistEntry[]
  emailLogs       EmailLog[]
  auditLogs       AuditLog[]

  @@map("users")
}

// ─── VENUES ─────────────────────────────────────

model Venue {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(200)
  address     String?  @db.Text
  description String?  @db.Text
  capacity    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  seats          Seat[]
  seatCategories SeatCategory[]
  events         Event[]

  @@map("venues")
}

// ─── SEAT CATEGORIES ────────────────────────────

model SeatCategory {
  id           String   @id @default(uuid()) @db.Uuid
  venueId      String   @map("venue_id") @db.Uuid
  name         String   @db.VarChar(50)
  color        String   @db.VarChar(7) // Hex color
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  venue           Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats           Seat[]
  eventSeatPrices EventSeatPrice[]
  waitlistEntries WaitlistEntry[]

  @@unique([venueId, name])
  @@map("seat_categories")
}

// ─── SEATS (Physical venue seats) ───────────────

model Seat {
  id         String   @id @default(uuid()) @db.Uuid
  venueId    String   @map("venue_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  row        String   @db.VarChar(5)
  column     Int
  seatNumber String   @map("seat_number") @db.VarChar(10)
  isActive   Boolean  @default(true) @map("is_active")
  isAisle    Boolean  @default(false) @map("is_aisle")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  venue      Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category   SeatCategory   @relation(fields: [categoryId], references: [id])
  eventSeats EventSeat[]

  @@unique([venueId, row, column])
  @@index([venueId])
  @@map("seats")
}

// ─── EVENTS ─────────────────────────────────────

enum EventType {
  MOVIE
  CONCERT
  THEATRE
  SPORTS
  COMEDY
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  CANCELLED
  COMPLETED
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  title       String      @db.VarChar(300)
  description String?     @db.Text
  posterUrl   String?     @map("poster_url") @db.VarChar(500)
  eventType   EventType   @map("event_type")
  venueId     String      @map("venue_id") @db.Uuid
  organiserId String      @map("organiser_id") @db.Uuid
  date        DateTime    @db.Date
  startTime   String      @map("start_time") @db.VarChar(10) // HH:MM format
  endTime     String?     @map("end_time") @db.VarChar(10)
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  venue           Venue            @relation(fields: [venueId], references: [id])
  organiser       User             @relation("EventOrganiser", fields: [organiserId], references: [id])
  eventSeats      EventSeat[]
  eventSeatPrices EventSeatPrice[]
  bookings        Booking[]
  seatHolds       SeatHold[]
  waitlistEntries WaitlistEntry[]

  @@index([status, date])
  @@index([venueId])
  @@index([organiserId])
  @@map("events")
}

// ─── EVENT SEAT PRICES ──────────────────────────

model EventSeatPrice {
  id         String @id @default(uuid()) @db.Uuid
  eventId    String @map("event_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  price      Decimal @db.Decimal(10, 2)

  // Relations
  event    Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category SeatCategory @relation(fields: [categoryId], references: [id])

  @@unique([eventId, categoryId])
  @@map("event_seat_prices")
}

// ─── EVENT SEATS (Inventory — THE Critical Table) ─

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
  OFFERED
}

model EventSeat {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @map("event_id") @db.Uuid
  seatId    String     @map("seat_id") @db.Uuid
  status    SeatStatus @default(AVAILABLE)
  version   Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seat          Seat           @relation(fields: [seatId], references: [id])
  holdItems     SeatHoldItem[]
  bookingItems  BookingItem[]
  waitlistOffers WaitlistOffer[]

  @@unique([eventId, seatId])
  @@index([eventId, status])
  @@map("event_seats")
}

// ─── SEAT HOLDS ─────────────────────────────────

enum HoldStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  RELEASED
}

model SeatHold {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @map("event_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  status    HoldStatus @default(ACTIVE)
  expiresAt DateTime   @map("expires_at") @db.Timestamptz()
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  event    Event          @relation(fields: [eventId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  items    SeatHoldItem[]
  booking  Booking?

  @@index([status, expiresAt])
  @@map("seat_holds")
}

// ─── SEAT HOLD ITEMS ────────────────────────────

model SeatHoldItem {
  id          String @id @default(uuid()) @db.Uuid
  holdId      String @map("hold_id") @db.Uuid
  eventSeatId String @map("event_seat_id") @db.Uuid

  // Relations
  hold      SeatHold  @relation(fields: [holdId], references: [id], onDelete: Cascade)
  eventSeat EventSeat @relation(fields: [eventSeatId], references: [id])

  @@unique([holdId, eventSeatId])
  @@map("seat_hold_items")
}

// ─── BOOKINGS ───────────────────────────────────

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  bookingRef     String        @unique @map("booking_ref") @db.VarChar(10)
  eventId        String        @map("event_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  holdId         String?       @unique @map("hold_id") @db.Uuid
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  status         BookingStatus @default(CONFIRMED)
  idempotencyKey String?       @unique @map("idempotency_key") @db.VarChar(255)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  event  Event         @relation(fields: [eventId], references: [id])
  user   User          @relation(fields: [userId], references: [id])
  hold   SeatHold?     @relation(fields: [holdId], references: [id])
  items  BookingItem[]
  ticket Ticket?
  emailLogs EmailLog[]

  @@index([userId])
  @@index([eventId])
  @@index([bookingRef])
  @@map("bookings")
}

// ─── BOOKING ITEMS ──────────────────────────────

model BookingItem {
  id           String  @id @default(uuid()) @db.Uuid
  bookingId    String  @map("booking_id") @db.Uuid
  eventSeatId  String  @map("event_seat_id") @db.Uuid
  seatLabel    String  @map("seat_label") @db.VarChar(10)
  categoryName String  @map("category_name") @db.VarChar(50)
  price        Decimal @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  eventSeat EventSeat @relation(fields: [eventSeatId], references: [id])

  @@map("booking_items")
}

// ─── TICKETS ────────────────────────────────────

model Ticket {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @unique @map("booking_id") @db.Uuid
  qrPayload  String   @map("qr_payload") @db.VarChar(255)
  qrDataUrl  String?  @map("qr_data_url") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

// ─── WAITLIST ENTRIES ───────────────────────────

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  EXPIRED
  CANCELLED
}

model WaitlistEntry {
  id         String         @id @default(uuid()) @db.Uuid
  eventId    String         @map("event_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  categoryId String         @map("category_id") @db.Uuid
  status     WaitlistStatus @default(WAITING)
  position   Int
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  event    Event          @relation(fields: [eventId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  category SeatCategory   @relation(fields: [categoryId], references: [id])
  offers   WaitlistOffer[]

  @@unique([eventId, userId, categoryId])
  @@index([eventId, categoryId, position])
  @@map("waitlist_entries")
}

// ─── WAITLIST OFFERS ────────────────────────────

enum OfferStatus {
  PENDING
  ACCEPTED
  EXPIRED
  DECLINED
  CANCELLED
}

model WaitlistOffer {
  id              String      @id @default(uuid()) @db.Uuid
  waitlistEntryId String      @map("waitlist_entry_id") @db.Uuid
  eventSeatId     String      @map("event_seat_id") @db.Uuid
  status          OfferStatus @default(PENDING)
  expiresAt       DateTime    @map("expires_at") @db.Timestamptz()
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  waitlistEntry WaitlistEntry @relation(fields: [waitlistEntryId], references: [id])
  eventSeat     EventSeat     @relation(fields: [eventSeatId], references: [id])

  @@index([status, expiresAt])
  @@map("waitlist_offers")
}

// ─── EMAIL LOGS ─────────────────────────────────

enum EmailType {
  BOOKING_CONFIRMATION
  WAITLIST_OFFER
  CANCELLATION
  WAITLIST_JOINED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailLog {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  bookingId    String?     @map("booking_id") @db.Uuid
  emailType    EmailType   @map("email_type")
  status       EmailStatus @default(PENDING)
  errorMessage String?     @map("error_message") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("email_logs")
}

// ─── AUDIT LOGS ─────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@map("audit_logs")
}
